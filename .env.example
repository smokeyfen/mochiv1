# M2-A only: Gemini 3.5 Flash Free Tier intelligence configuration.
# Set this value locally. Never commit, print, or log a real API key.
GEMINI_API_KEY=

# Video generation is intentionally not configured in M2-A. M2-B will be a
# separate Flow Video Canary, using Flow credits rather than Gemini API video.
# Never commit Flow bearer tokens or browser-session secrets.
MOCHI_VIDEO_PROVIDER=disabled
